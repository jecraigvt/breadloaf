generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id              String   @id @default(cuid())
  title           String
  description     String?
  fileName        String
  filePath        String
  fileType        String
  fileSize        Int
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            String?
  aiSummary       String?
  aiExtractedText String?
  uploadedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([createdAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  icon      String?
  color     String?
  documents Document[]
  createdAt DateTime   @default(now())
}

model BulletinMessage {
  id        String   @id @default(cuid())
  author    String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Room {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  type        String  // bedroom, annex, loft, cabin, tent, offsite
  minCapacity Int
  maxCapacity Int
  hasCrib     Boolean @default(false)
  description String?
  sortOrder   Int     @default(0)
  stays       Stay[]
}

model Stay {
  id            String   @id @default(cuid())
  guestName     String
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  notes         String?
  status        String   @default("confirmed") // confirmed, tentative, requested
  googleEventId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([roomId])
  @@index([checkIn])
  @@index([checkOut])
}

model GroceryItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("General")
  checked   Boolean  @default(false)
  addedBy   String?
  checkedBy String?
  priority  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checked])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  name      String
  list      String   // "opening" or "closing"
  section   String   @default("General")
  sortOrder Int      @default(0)
  checked   Boolean  @default(false)
  checkedBy String?
  checkedAt DateTime?
  createdAt DateTime @default(now())

  @@index([list])
}

model MaintenanceRecord {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String    @default("General")
  performedBy String?
  performedAt DateTime
  nextDueAt   DateTime?
  cost        Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([performedAt])
}

model FamilyMember {
  id       String  @id @default(cuid())
  name     String
  email    String?
  phone    String?
  birthday String?
  branch   String? // which Craig brother's family
  relation String? // e.g. "spouse", "child", "grandchild"
  notes    String?

  @@index([branch])
}

model DinnerSignup {
  id        String   @id @default(cuid())
  date      DateTime
  chef      String
  meal      String?
  notes     String?
  headCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  description String
  category    String   @default("other") // utilities, maintenance, insurance, taxes, improvements, supplies, professional-services, other
  type        String   @default("operating") // operating, capital
  paidBy      String   @default("Shared") // Tom, Jim, Sandy, Greg, Shared
  vendor      String?
  documentId  String?  // optional link to a scanned receipt/document
  notes       String?
  fiscalYear  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fiscalYear])
  @@index([category])
  @@index([paidBy])
  @@index([date])
}

model PantryItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("General")
  quantity  Int      @default(1)
  unit      String?
  expiresAt String?
  notes     String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
