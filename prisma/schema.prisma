generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id              String    @id @default(cuid())
  title           String
  description     String?
  fileName        String
  filePath        String
  fileType        String
  fileSize        Int
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            String?
  aiSummary       String?
  aiExtractedText String?
  analysisState   String    @default("provider_error")
  analysisError   String?
  uploadedBy      String?
  checksum        String?
  accessScope     String    @default("family") // family, board, vault
  backupStatus    String    @default("local-only")
  deletedAt       DateTime?
  deletedBy       String?
  assetId         String?
  asset           Asset?    @relation(fields: [assetId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
  @@index([createdAt])
  @@index([assetId])
  @@index([checksum])
  @@index([deletedAt])
  @@index([accessScope])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  icon        String?
  color       String?
  description String?
  documents   Document[]
  createdAt   DateTime   @default(now())
}

model BulletinMessage {
  id        String   @id @default(cuid())
  author    String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Room {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  type        String // bedroom, annex, loft, cabin, tent, offsite
  minCapacity Int
  maxCapacity Int
  hasCrib     Boolean @default(false)
  description String?
  sortOrder   Int     @default(0)
  stays       Stay[]
}

model Stay {
  id            String   @id @default(cuid())
  guestName     String
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  notes         String?
  status        String   @default("confirmed") // confirmed, tentative, requested
  googleEventId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([roomId])
  @@index([checkIn])
  @@index([checkOut])
}

// Processed inbound family emails (dedupe + audit trail)
model EmailLog {
  id         String   @id @default(cuid())
  messageId  String   @unique
  fromEmail  String
  subject    String?
  receivedAt DateTime
  actions    String? // JSON summary of what was created (stays, docs, notes)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model GroceryItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("General")
  checked   Boolean  @default(false)
  addedBy   String?
  checkedBy String?
  priority  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checked])
}

model ChecklistItem {
  id        String    @id @default(cuid())
  name      String
  list      String // "opening" or "closing"
  section   String    @default("General")
  sortOrder Int       @default(0)
  checked   Boolean   @default(false)
  checkedBy String?
  checkedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([list])
}

model MaintenanceRecord {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String    @default("General")
  performedBy String?
  performedAt DateTime
  nextDueAt   DateTime?
  cost        Float?
  // Immutable source evidence for maintenance dictated to Bucky. The normal
  // description is Bucky's concise summary; these retain the unedited machine
  // transcript and playable recording together.
  sourceRecordings Json?
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([performedAt])
  @@index([assetId])
}

// Permanently installed systems & major equipment — the property's
// "notebook". Bucky creates/updates these as he learns about them from
// conversation, documents, and voice-memo walkthroughs (save_asset tool).
model Asset {
  id            String              @id @default(cuid())
  name          String              @unique
  category      String              @default("other") // water, power, hvac, structure, appliance, grounds, safety, other
  location      String? // where on the property
  make          String?
  model         String?
  serial        String?
  installedYear Int?
  notes         String? // quirks, tips, history — appended over time
  status        String              @default("active") // active, retired
  addedBy       String?
  records       MaintenanceRecord[]
  documents     Document[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([category])
}

model FamilyMember {
  id            String  @id @default(cuid())
  name          String
  displayName   String? // what the tree shows ("Sandy", "KC"); falls back to first token of name
  surname       String? // current surname — the tree has Craigs, Kellers, and Devlins
  maidenName    String? // rendered as "née X" when it differs from surname
  email         String?
  phone         String?
  birthday      String?
  branch        String? // DERIVED cache — the relationship graph is the source of truth. See src/lib/family-tree.ts
  relation      String? // legacy free text, kept so historical display strings survive
  boardRole     String? // officer role: President, VP, Treasurer, Secretary
  isBoardMember Boolean @default(false)
  notes         String?

  // Tree + identity
  photoUrl     String?
  isBranchRoot Boolean @default(false) // the four brothers — where branch derivation starts
  isFounder    Boolean @default(false) // Bill and Lois — an honour, NOT a layout anchor

  sortOrder   Int       @default(0) // birth order within a sibling set
  isMinor     Boolean   @default(false) // redacted to first name pre-login; cannot claim
  canClaim    Boolean   @default(true) // false for minors, deceased, and former spouses
  deceased    Boolean   @default(false)
  needsReview String? // curator note describing what is still unconfirmed
  isCurator   Boolean   @default(false)
  claimedAt   DateTime?
  lastSeenAt  DateTime?

  positions  PositionAssignment[]
  relFrom    FamilyRelationship[] @relation("RelationshipFrom")
  relTo      FamilyRelationship[] @relation("RelationshipTo")
  sessions   FamilySession[]
  credential FamilyCredential?

  @@index([branch])
  @@index([claimedAt])
}

// Graph edges. Parent edges are directional (from = parent, to = child) and
// attach to INDIVIDUAL parents, never to a couple — Riley is Sandy + Kirsten's
// child while Sandy's current marriage is to Andrea, so a couple-as-container
// model would misplace her. Couples are grouped at render time instead.
// Spouse edges are stored in one canonical direction and treated as symmetric.
model FamilyRelationship {
  id           String    @id @default(cuid())
  fromMemberId String
  toMemberId   String
  type         String // parent | spouse
  status       String    @default("current") // current | former
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  from FamilyMember @relation("RelationshipFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  to   FamilyMember @relation("RelationshipTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([fromMemberId, toMemberId, type])
  @@index([fromMemberId, type])
  @@index([toMemberId, type])
}

// Optional per-person PIN. Empty until someone opts into locking their profile —
// the shared FAMILY_PINS door is what keeps strangers out in the meantime.
model FamilyCredential {
  id        String       @id @default(cuid())
  memberId  String       @unique
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pinHash   String // keyed HMAC-SHA-256, never the PIN itself
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Long-lived per-device identity. Rows are revoked, never deleted, so they double
// as the audit trail for who claimed which profile and when.
model FamilySession {
  id         String       @id @default(cuid())
  memberId   String
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  userAgent  String?
  claimedVia String? // tap | pin
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime     @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([memberId])
  @@index([expiresAt])
}

model PositionAssignment {
  id          String        @id @default(cuid())
  position    String
  personName  String
  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  effectiveAt DateTime
  endedAt     DateTime?
  sourceType  String?
  sourceId    String?
  sourceLabel String?
  createdBy   String        @default("Bucky")
  createdAt   DateTime      @default(now())

  @@index([position, endedAt])
  @@index([memberId])
  @@index([effectiveAt])
}

model BuckyQuestion {
  id             String    @id @default(cuid())
  question       String
  context        String?
  status         String    @default("open") // open, staged (pre-deploy proposals), answered, dismissed
  targetPerson   String?
  questionType   String    @default("clarification")
  sourceType     String?
  sourceId       String?
  sourceLabel    String?
  options        Json?
  proposedAction Json?
  answer         String?
  answeredBy     String?
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetPerson, status])
}

model BuckyLedgerEntry {
  id          String    @id @default(cuid())
  actionType  String
  summary     String
  details     String?
  actor       String    @default("Bucky")
  initiatedBy String?
  entityType  String?
  entityId    String?
  sourceType  String?
  sourceId    String?
  sourceLabel String?
  beforeState Json?
  afterState  Json?
  reversible  Boolean   @default(false)
  revertedAt  DateTime?
  revertedBy  String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([actionType])
  @@index([entityType, entityId])
}

model CorporateAccount {
  id                 String   @id @default(cuid())
  serviceName        String
  category           String   @default("utility")
  loginUrl           String?
  username           String?
  accountNumberLast4 String?
  responsiblePerson  String?
  recoveryContact    String?
  notes              String?
  encryptedSecret    String?
  secretIv           String?
  encryptionVersion  Int      @default(1)
  status             String   @default("active") // active, archived
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, category])
  @@index([serviceName])
}

model VaultConfiguration {
  id           String   @id
  passwordHash String
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DinnerSignup {
  id        String   @id @default(cuid())
  date      DateTime
  chef      String
  meal      String?
  notes     String?
  headCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  description String
  category    String   @default("other") // utilities, maintenance, insurance, taxes, improvements, supplies, professional-services, other
  type        String   @default("operating") // operating, capital
  paidBy      String   @default("Shared") // Tom, Jim, Sandy, Greg, Shared
  vendor      String?
  documentId  String? // optional link to a scanned receipt/document
  notes       String?
  fiscalYear  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fiscalYear])
  @@index([category])
  @@index([paidBy])
  @@index([date])
}

model JarvisMemory {
  id             String    @id @default(cuid())
  type           String // semantic (facts/prefs), episodic (events), procedural (how-to)
  topic          String // short label: "roof repair", "sandy's role", "insurance renewal"
  content        String // the actual memory
  source         String? // human-readable provenance: "conversation with Jim", "board meeting"
  sourceType     String?
  sourceId       String?
  filePath       String? // retained source artifact, currently used by attributed voice notes
  scope          String    @default("property") // property, family, user, entity
  subject        String?
  location       String? // physical location, kept separate for exact "where is it" retrieval
  confidence     Float     @default(1.0)
  importance     Float     @default(0.5)
  validFrom      DateTime?
  validUntil     DateTime?
  status         String    @default("active") // active, superseded, disputed
  supersededById String?
  lastUsedAt     DateTime?
  useCount       Int       @default(0)
  accessScope    String    @default("family") // family; reserved for future scoped retrieval
  relevance      Float     @default(1.0) // legacy field; retrieval ranking no longer treats age as truth decay
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@index([topic])
  @@index([status, accessScope])
  @@index([scope, subject])
  @@index([validUntil])
}

model Embedding {
  id           String                       @id @default(cuid())
  sourceType   String // document, memory, asset, expense, maintenance
  sourceId     String
  chunkIndex   Int                          @default(0)
  content      String // contextualized source chunk used for keyword + vector retrieval
  vector       String // JSON source retained for Prisma writes; DB trigger mirrors it into pgvector
  embedding    Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType])
  @@index([sourceType, sourceId])
}

model PantryItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("General")
  quantity  Int      @default(1)
  unit      String?
  expiresAt String?
  notes     String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// A recorded harness run. Written by scripts/verify-archive-*.ts so the health
// panel reports what was actually measured rather than a constant someone has
// to remember to edit — a literal that reads as a measurement is the same
// species as the placeholder summaries that hid eight unfindable documents.
model ArchiveVerification {
  id             String   @id @default(cuid())
  suite          String // round-trip | golden
  passed         Int
  total          Int
  rate           Float
  controlsPassed Int
  controlsTotal  Int
  failures       Json?
  measuredAt     DateTime @default(now())

  @@index([suite, measuredAt])
}

// Durable work stays here; computers, API runners, and their sessions are replaceable.
model BuckyJob {
  id                String   @id @default(cuid())
  kind              String
  status            String   @default("queued")
  request           Json
  sourceDocumentId  String?
  sourceVersion     String?
  checkpoint        Json?
  result            Json?
  initiatedById     String?
  initiatedByName   String?
  priority          Int      @default(0)
  fallbackAfter     DateTime
  apiNotBefore      DateTime?
  nextAttemptAt     DateTime @default(now())
  generation        Int      @default(0)
  dedupeKey         String?  @unique
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  attempts          BuckyJobAttempt[]

  @@index([status, priority, nextAttemptAt])
  @@index([sourceDocumentId, createdAt])
  @@index([fallbackAfter])
}

model BuckyWorker {
  id             String   @id
  label          String
  tokenHash      String   @unique
  provider       String
  capabilities   Json
  paused         Boolean  @default(false)
  lastSeenAt     DateTime?
  quotaRemaining Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  attempts       BuckyJobAttempt[]
}

model BuckyJobAttempt {
  id             String   @id @default(cuid())
  jobId          String
  workerId       String
  generation     Int
  leaseToken     String   @unique
  leaseExpiresAt DateTime
  status         String   @default("running")
  reservedCents  Int      @default(0)
  costCents      Int?
  budgetMonth    String?
  usage          Json?
  error          String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  job            BuckyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker         BuckyWorker @relation(fields: [workerId], references: [id])

  @@unique([jobId, generation])
  @@index([workerId, status, leaseExpiresAt])
  @@index([status, leaseExpiresAt])
}

// A row lock serializes reservations, including claims by different API runners.
model BuckyApiBudget {
  month         String   @id
  spentCents    Int      @default(0)
  reservedCents Int      @default(0)
  updatedAt     DateTime @updatedAt
}
