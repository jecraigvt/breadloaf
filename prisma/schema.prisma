generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id              String    @id @default(cuid())
  title           String
  description     String?
  fileName        String
  filePath        String
  fileType        String
  fileSize        Int
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            String?
  aiSummary       String?
  aiExtractedText String?
  uploadedBy      String?
  checksum        String?
  accessScope     String    @default("family") // family, board, vault
  backupStatus    String    @default("local-only")
  deletedAt       DateTime?
  deletedBy       String?
  assetId         String?
  asset           Asset?    @relation(fields: [assetId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
  @@index([createdAt])
  @@index([assetId])
  @@index([checksum])
  @@index([deletedAt])
  @@index([accessScope])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  icon        String?
  color       String?
  description String?
  documents   Document[]
  createdAt   DateTime   @default(now())
}

model BulletinMessage {
  id        String   @id @default(cuid())
  author    String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Room {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  type        String // bedroom, annex, loft, cabin, tent, offsite
  minCapacity Int
  maxCapacity Int
  hasCrib     Boolean @default(false)
  description String?
  sortOrder   Int     @default(0)
  stays       Stay[]
}

model Stay {
  id            String   @id @default(cuid())
  guestName     String
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  notes         String?
  status        String   @default("confirmed") // confirmed, tentative, requested
  googleEventId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([roomId])
  @@index([checkIn])
  @@index([checkOut])
}

// Processed inbound family emails (dedupe + audit trail)
model EmailLog {
  id         String   @id @default(cuid())
  messageId  String   @unique
  fromEmail  String
  subject    String?
  receivedAt DateTime
  actions    String? // JSON summary of what was created (stays, docs, notes)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model GroceryItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("General")
  checked   Boolean  @default(false)
  addedBy   String?
  checkedBy String?
  priority  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checked])
}

model ChecklistItem {
  id        String    @id @default(cuid())
  name      String
  list      String // "opening" or "closing"
  section   String    @default("General")
  sortOrder Int       @default(0)
  checked   Boolean   @default(false)
  checkedBy String?
  checkedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([list])
}

model MaintenanceRecord {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String    @default("General")
  performedBy String?
  performedAt DateTime
  nextDueAt   DateTime?
  cost        Float?
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([performedAt])
  @@index([assetId])
}

// Permanently installed systems & major equipment — the property's
// "notebook". Bucky creates/updates these as he learns about them from
// conversation, documents, and voice-memo walkthroughs (save_asset tool).
model Asset {
  id            String              @id @default(cuid())
  name          String              @unique
  category      String              @default("other") // water, power, hvac, structure, appliance, grounds, safety, other
  location      String? // where on the property
  make          String?
  model         String?
  serial        String?
  installedYear Int?
  notes         String? // quirks, tips, history — appended over time
  status        String              @default("active") // active, retired
  addedBy       String?
  records       MaintenanceRecord[]
  documents     Document[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([category])
}

model FamilyMember {
  id            String               @id @default(cuid())
  name          String
  email         String?
  phone         String?
  birthday      String?
  branch        String? // which Craig brother's family
  relation      String? // e.g. "spouse", "child", "grandchild"
  boardRole     String? // officer role: President, VP, Treasurer, Secretary
  isBoardMember Boolean              @default(false)
  notes         String?
  positions     PositionAssignment[]

  @@index([branch])
}

model PositionAssignment {
  id          String        @id @default(cuid())
  position    String
  personName  String
  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  effectiveAt DateTime
  endedAt     DateTime?
  sourceType  String?
  sourceId    String?
  sourceLabel String?
  createdBy   String        @default("Bucky")
  createdAt   DateTime      @default(now())

  @@index([position, endedAt])
  @@index([memberId])
  @@index([effectiveAt])
}

model BuckyQuestion {
  id             String    @id @default(cuid())
  question       String
  context        String?
  status         String    @default("open") // open, answered, dismissed
  targetPerson   String?
  questionType   String    @default("clarification")
  sourceType     String?
  sourceId       String?
  sourceLabel    String?
  options        Json?
  proposedAction Json?
  answer         String?
  answeredBy     String?
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetPerson, status])
}

model BuckyLedgerEntry {
  id          String    @id @default(cuid())
  actionType  String
  summary     String
  details     String?
  actor       String    @default("Bucky")
  initiatedBy String?
  entityType  String?
  entityId    String?
  sourceType  String?
  sourceId    String?
  sourceLabel String?
  beforeState Json?
  afterState  Json?
  reversible  Boolean   @default(false)
  revertedAt  DateTime?
  revertedBy  String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([actionType])
  @@index([entityType, entityId])
}

model CorporateAccount {
  id                 String   @id @default(cuid())
  serviceName        String
  category           String   @default("utility")
  loginUrl           String?
  username           String?
  accountNumberLast4 String?
  responsiblePerson  String?
  recoveryContact    String?
  notes              String?
  encryptedSecret    String?
  secretIv           String?
  encryptionVersion  Int      @default(1)
  status             String   @default("active") // active, archived
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, category])
  @@index([serviceName])
}

model VaultConfiguration {
  id           String   @id
  passwordHash String
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DinnerSignup {
  id        String   @id @default(cuid())
  date      DateTime
  chef      String
  meal      String?
  notes     String?
  headCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  description String
  category    String   @default("other") // utilities, maintenance, insurance, taxes, improvements, supplies, professional-services, other
  type        String   @default("operating") // operating, capital
  paidBy      String   @default("Shared") // Tom, Jim, Sandy, Greg, Shared
  vendor      String?
  documentId  String? // optional link to a scanned receipt/document
  notes       String?
  fiscalYear  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fiscalYear])
  @@index([category])
  @@index([paidBy])
  @@index([date])
}

model JarvisMemory {
  id             String    @id @default(cuid())
  type           String // semantic (facts/prefs), episodic (events), procedural (how-to)
  topic          String // short label: "roof repair", "sandy's role", "insurance renewal"
  content        String // the actual memory
  source         String? // human-readable provenance: "conversation with Jim", "board meeting"
  sourceType     String?
  sourceId       String?
  scope          String    @default("property") // property, family, user, entity
  subject        String?
  confidence     Float     @default(1.0)
  importance     Float     @default(0.5)
  validFrom      DateTime?
  validUntil     DateTime?
  status         String    @default("active") // active, superseded, disputed
  supersededById String?
  lastUsedAt     DateTime?
  useCount       Int       @default(0)
  accessScope    String    @default("family") // family; reserved for future scoped retrieval
  relevance      Float     @default(1.0) // legacy field; retrieval ranking no longer treats age as truth decay
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@index([topic])
  @@index([status, accessScope])
  @@index([scope, subject])
  @@index([validUntil])
}

model Embedding {
  id         String   @id @default(cuid())
  sourceType String // document, memory, asset, expense, maintenance
  sourceId   String
  chunkIndex Int      @default(0)
  content    String // contextualized source chunk used for keyword + vector retrieval
  vector     String // JSON array of floats
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType])
  @@index([sourceType, sourceId])
}

model PantryItem {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("General")
  quantity  Int      @default(1)
  unit      String?
  expiresAt String?
  notes     String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
