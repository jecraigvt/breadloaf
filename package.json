{
  "name": "breadloaf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "tsx --test src/lib/*.test.ts",
    "start": "prisma migrate deploy && prisma db seed && next start",
    "lint": "next lint",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma migrate reset",
    "archive:verify": "npm run archive:verify:checksums && npm run archive:verify:roundtrip",
    "archive:verify:checksums": "npx tsx scripts/verify-archive.ts",
    "archive:verify:roundtrip": "npx tsx scripts/verify-archive-retrieval.ts",
    "archive:retitle": "npx tsx scripts/retitle-documents.ts",
    "memory:reindex": "npx tsx scripts/re-embed.ts",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.4.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "playwright": "^1.59.1",
    "prisma": "^6.19.2",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
